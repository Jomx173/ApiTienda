{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "app/**/*.ts",
    "generated/**/*.ts",
    "prisma7.config.ts"
, "app/middlewares/authenticate.ts", "app/middlewares/rateLimiter.ts", "app/middlewares/requestLogger.ts", "app/middlewares/requirePermission.ts", "app/middlewares/validateRequest.ts"  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
