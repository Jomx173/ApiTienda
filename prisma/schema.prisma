generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model carritos {
  id_carrito      Int               @id @default(autoincrement())
  id_cliente      Int
  fecha_creacion  DateTime?         @db.Timestamp(6)
  estado          String?           @db.VarChar(30)
  clientes        clientes          @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  detalle_carrito detalle_carrito[]
}

model categorias {
  id_categoria Int         @id @default(autoincrement())
  nombre       String?     @db.VarChar(100)
  descripcion  String?     @db.VarChar(255)
  estado       Boolean?
  productos    productos[]
}

model clientes {
  id_cliente     Int        @id @default(autoincrement())
  nombre         String?    @db.VarChar(100)
  apellido       String?    @db.VarChar(100)
  telefono       String?    @db.VarChar(20)
  correo         String?    @unique @db.VarChar(150)
  direccion      String?    @db.VarChar(255)
  fecha_registro DateTime?  @db.Timestamp(6)
  carritos       carritos[]
  usuarios       usuarios?
  ventas         ventas[]
}

model detalle_carrito {
  id_detalle_carrito Int       @id @default(autoincrement())
  id_carrito         Int
  id_producto        Int
  cantidad           Int?
  carritos           carritos  @relation(fields: [id_carrito], references: [id_carrito], onDelete: NoAction, onUpdate: NoAction)
  productos          productos @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_metodo_pago {
  id_detalle_pago Int          @id @default(autoincrement())
  id_venta        Int
  id_metodo_pago  Int
  monto           Decimal?     @db.Decimal(10, 2)
  referencia      String?      @db.VarChar(150)
  fecha_pago      DateTime?    @db.Timestamp(6)
  estado          String?      @db.VarChar(30)
  metodos_pago    metodos_pago @relation(fields: [id_metodo_pago], references: [id_metodo_pago], onDelete: NoAction, onUpdate: NoAction)
  ventas          ventas       @relation(fields: [id_venta], references: [id_venta], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_ventas {
  id_detalle_venta Int       @id @default(autoincrement())
  id_venta         Int
  id_producto      Int
  cantidad         Int?
  precio_unitario  Decimal?  @db.Decimal(10, 2)
  subtotal         Decimal?  @db.Decimal(10, 2)
  productos        productos @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
  ventas           ventas    @relation(fields: [id_venta], references: [id_venta], onDelete: NoAction, onUpdate: NoAction)
}

model metodos_pago {
  id_metodo_pago      Int                   @id @default(autoincrement())
  nombre              String?               @db.VarChar(100)
  descripcion         String?               @db.VarChar(255)
  estado              Boolean?
  detalle_metodo_pago detalle_metodo_pago[]
}

model productos {
  id_producto     Int               @id @default(autoincrement())
  id_categoria    Int
  nombre          String?           @db.VarChar(150)
  descripcion     String?
  precio          Decimal?          @db.Decimal(10, 2)
  stock           Int?
  imagen          String?           @db.VarChar(255)
  estado          Boolean?
  fecha_registro  DateTime?         @db.Timestamp(6)
  detalle_carrito detalle_carrito[]
  detalle_ventas  detalle_ventas[]
  categorias      categorias        @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
}

model usuarios {
  id_usuario Int      @id @default(autoincrement())
  id_cliente Int      @unique
  usuario    String?  @unique @db.VarChar(50)
  password   String?  @db.VarChar(255)
  rol        String?  @db.VarChar(30)
  estado     Boolean?
  clientes   clientes @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
}

model ventas {
  id_venta            Int                   @id @default(autoincrement())
  id_cliente          Int
  fecha_venta         DateTime?             @db.Timestamp(6)
  total               Decimal?              @db.Decimal(10, 2)
  estado              String?               @db.VarChar(30)
  direccion_entrega   String?               @db.VarChar(255)
  detalle_metodo_pago detalle_metodo_pago[]
  detalle_ventas      detalle_ventas[]
  clientes            clientes              @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
}
